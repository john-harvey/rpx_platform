{
  "name": "secure-meeting",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:tunnel": "node server-pkg.js",
    "setup-pinning": "node generate-keys.js",
    "setup-ssl": "node generate-ssl-cert.js",
    "setup": "npm run setup-ssl && npm run setup-pinning",
    "build:mac": "pkg server-cjs.cjs --target node18-macos-x64 --output dist/secure-meeting-mac",
    "build:win": "pkg server-cjs.cjs --target node18-win-x64 --output dist/secure-meeting-win.exe",
    "build:all": "npm run build:mac && npm run build:win"
  },
  "pkg": {
    "assets": [
      "index.html",
      "client.js",
      "crypto.js",
      "styles.css",
      "ssl/**/*",
      "server-identity-private.pem",
      "server-identity-public.pem"
    ]
  },
  "dependencies": {
    "cloudflared": "^0.7.1",
    "open": "^8.4.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
